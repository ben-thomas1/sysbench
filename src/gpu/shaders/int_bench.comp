#version 450

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) buffer Buf {
    uint data[];
};

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint s = data[tid];

    uint a0=s,    a1=s+1u, a2=s+2u, a3=s+3u, a4=s+4u,
         a5=s+5u, a6=s+6u, a7=s+7u, a8=s+8u, a9=s+9u;

    uint b = 0x4F6CDD1Du;
    uint c = 0x7F4A7C15u;

    for (int i = 0; i < 4096; i++) {
        a0 = a0*b+c; a1 = a1*b+c; a2 = a2*b+c; a3 = a3*b+c; a4 = a4*b+c;
        a5 = a5*b+c; a6 = a6*b+c; a7 = a7*b+c; a8 = a8*b+c; a9 = a9*b+c;
    }

    data[tid] = a0+a1+a2+a3+a4+a5+a6+a7+a8+a9;
}
