#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer Buf { float16_t data[]; };

void main() {
    uint tid = gl_GlobalInvocationID.x;
    float16_t s = data[tid];
    float16_t a0=s, a1=s+float16_t(0.1), a2=s+float16_t(0.2);
    float16_t a3=s+float16_t(0.3), a4=s+float16_t(0.4);
    float16_t a5=s+float16_t(0.5), a6=s+float16_t(0.6);
    float16_t a7=s+float16_t(0.7), a8=s+float16_t(0.8);
    float16_t a9=s+float16_t(0.9);
    float16_t b = float16_t(0.999), c = float16_t(0.001);
    for (int i = 0; i < 4096; i++) {
        a0 = a0*b+c; a1 = a1*b+c; a2 = a2*b+c;
        a3 = a3*b+c; a4 = a4*b+c; a5 = a5*b+c;
        a6 = a6*b+c; a7 = a7*b+c; a8 = a8*b+c;
        a9 = a9*b+c;
    }
    data[tid] = (a0+a1+a2+a3+a4+a5+a6+a7+a8+a9) * float16_t(0.1);
}
