#version 450

layout(local_size_x = 256) in;
layout(set = 0, binding = 0) buffer Buf { float data[]; };

shared float smem[256];

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint lid = gl_LocalInvocationID.x;

    smem[lid] = data[gid];
    barrier();

    float sum = 0.0;
    for (int i = 0; i < 256; i++) {
        sum += smem[(lid + i) & 255];
    }
    data[gid] = sum / 256.0;
}
