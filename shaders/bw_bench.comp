#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Data {
    vec4 data[];
};

void main() {
    uint local_id = gl_LocalInvocationID.x;
    uint wg_base = gl_WorkGroupID.x * 256u * 256u;

    vec4 sum = vec4(0.0);
    for (uint i = 0u; i < 256u; i++) {
        sum += data[wg_base + i * 256u + local_id];
    }
    data[wg_base + local_id] = sum / 256.0;
}
